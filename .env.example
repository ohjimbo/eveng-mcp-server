# ═══════════════════════════════════════════════════════════════════════════
#  eveng-mcp-server configuration
#  Copy to .env and fill in. NO value here is a working default for a secret —
#  the server refuses to start if required values are missing.
# ═══════════════════════════════════════════════════════════════════════════

# ── Required: EVE-NG target ─────────────────────────────────────────────────
EVENG_HOST=192.0.2.10                 # IP or hostname of your EVE-NG server
EVENG_USER=admin                      # EVE-NG API username
EVENG_PASS=                           # EVE-NG API password (required)
EVENG_PROTOCOL=https                  # http or https (default https)
EVENG_VERIFY_SSL=false                # verify EVE-NG TLS cert (default false — self-signed is the norm)

# ── Required: MCP server ────────────────────────────────────────────────────
MCP_AUTH_TOKEN=                       # bearer token clients must present (required; generate a long random string)
MCP_PORT=8080                         # listen port (default 8080)
#MCP_HOST=0.0.0.0                     # bind address; use 127.0.0.1 behind a local TLS reverse proxy

# ── Optional: behavior flags ────────────────────────────────────────────────
#EVENG_MCP_READ_ONLY=true             # register only read tools (no create/delete/start/stop/console-write)
#EVENG_MCP_INTEGRATIONS=idrac,netbox  # explicit allowlist; listed-but-unconfigured = startup ERROR
#EVENG_MCP_DISABLE=junos_mcp          # disable specific integrations even if configured
#EVENG_PLATFORM_MAP=/path/to/platforms.yaml   # override the shipped template→platform mapping

# ── Optional: console defaults ──────────────────────────────────────────────
# Default credentials used when a console login prompt appears and the tool
# call doesn't supply its own. Per-call args always win.
#CONSOLE_USER=
#CONSOLE_PASS=

# ── Integration: idrac (power control for the EVE-NG bare-metal host) ───────
#IDRAC_HOST=192.0.2.11
#IDRAC_USER=
#IDRAC_PASS=
#IDRAC_VERIFY_SSL=false               # verify iDRAC TLS cert (default false — BMC self-signed certs are the norm)

# ── Integration: gitlab_backup (version node configs into a GitLab project) ─
#GITLAB_URL=https://gitlab.example.com
#GITLAB_TOKEN=
#GITLAB_BACKUP_PROJECT=you/eveng-backups   # project path or numeric ID

# ── Integration: junos_mcp (publish lab inventory to junos-mcp-server) ──────
# Requires the junos-mcp-server container on the SAME Docker host as this
# server, and /var/run/docker.sock mounted into this container.
#JMCP_URL=http://localhost:30030
#JMCP_CONTAINER=junos-mcp-server
#JMCP_DEVICES_PATH=/app/config/devices.json
#JMCP_DEVICE_USER=                    # SSH creds junos-mcp-server will use for lab devices
#JMCP_DEVICE_PASS=
#DOCKER_SOCKET=/var/run/docker.sock   # may point at a filtering socket proxy (recommended) — see README

# ── Integration: netbox (preview/build labs from NetBox, publish, diff) ─────
#NETBOX_URL=https://netbox.example.com
#NETBOX_TOKEN=
#NETBOX_VERIFY_SSL=true               # verify NetBox TLS cert (default true — set false only for self-signed/dev)
